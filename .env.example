# Copy to .env (git-ignored). Used by docker compose and IntelliJ (EnvFile plugin).
APP_VERSION=0.1.0
SPRING_PROFILES_ACTIVE=local            # local | local,local-offline | local,floci-bedrock
AWS_REGION=us-east-1
AWS_PROFILE=bedrock-dev                  # IAM Identity Center profile (aws configure sso)
# AWS_DIR=C:/Users/<you>/.aws            # Windows path to your .aws folder for the app container
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
GUARDRAIL_MODE=LOCAL                     # LOCAL | BEDROCK | NONE
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT
FLOCI_TAG=latest                         # pin e.g. 1.6.0
FLOCI_BEDROCK_BACKEND=stub               # stub | proxy
OLLAMA_MODEL=qwen3:8b
